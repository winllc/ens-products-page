# Static product site, and the proxy in front of the licensing service.
#
# The static files are rendered into /usr/share/nginx/html at container start
# by /docker-entrypoint.d/30-render-site.sh, which resolves the demo URLs; Astro
# builds them in the image's first stage.
#
# This is a template: the nginx entrypoint replaces ${LICENSING_UPSTREAM} and
# ${DNS_RESOLVER} from the environment before nginx starts.

# Which paths the licensing service answers. Its responses carry their own
# headers (set in src/middleware.ts), including a stricter Content-Security-
# Policy than the static pages can use, so the maps below give those paths an
# empty value, and nginx adds no header whose value is empty.
map $uri $ens_static {
    ~^/(account|admin|api/licensing|api/audit)(/|$)  0;
    default                                          1;
}

# The static pages' Content-Security-Policy. As built, the pages load their
# scripts and stylesheet from /_astro/ and carry no inline script or style
# (astro.config.mjs sets assetsInlineLimit to 0 to keep it that way, and CI
# checks the rendered pages), so 'unsafe-inline' is needed for neither. The
# contact form posts to mailto: today and may post to /api/licensing/contact
# later, hence both in form-action. JSON-LD <script type="application/ld+json">
# blocks are data, not script, and are not subject to script-src.
map $ens_static $ens_csp {
    1  "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; form-action 'self' mailto:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'";
    0  "";
}

# Caching. Astro's bundles (/_astro/) carry a content hash in their file names,
# so a changed file is a new URL and they can be kept for as long as the browser
# likes. Images under /assets/ keep their names; the render script versions
# every reference to them by content hash instead, so a week is safe. The pages
# themselves have the demo URLs filled in at container start and must not be
# cached across a restart. The licensing service sets its own (no-store).
map $uri $ens_cache_control {
    ~^/(account|admin|api/licensing|api/audit)(/|$)  "";
    ~^/_astro/                                       "public, max-age=31536000, immutable";
    ~^/assets/                                       "public, max-age=604800";
    default                                          "no-cache";
}

server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Response headers. All of them are declared here, at server level, and
    # none in a location: nginx drops every inherited add_header in a location
    # that declares one of its own, so a header set per location is a header
    # silently missing elsewhere. The values that differ by path come from the
    # maps above, and an empty value means the header is not sent.
    add_header X-Content-Type-Options  "nosniff"                          always;
    add_header X-Frame-Options         "SAMEORIGIN"                       always;
    add_header Referrer-Policy         "strict-origin-when-cross-origin"  always;
    add_header Permissions-Policy      "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy $ens_csp                           always;
    add_header Cache-Control           $ens_cache_control                 always;

    # No directory listings.
    autoindex off;

    gzip             on;
    gzip_vary        on;
    gzip_min_length  512;
    gzip_types       text/plain text/css application/javascript text/javascript image/svg+xml application/xml;

    # The licensing service is looked up per request, so nginx starts (and the
    # static site works) even when it isn't running; requests for it then get
    # the "licensing unavailable" page.
    resolver ${DNS_RESOLVER} valid=30s ipv6=off;
    set $licensing http://${LICENSING_UPSTREAM};

    # /api/audit is the audit trail's pull API for SIEMs (bearer token).
    location ~ ^/(account|admin|api/licensing|api/audit)(/|$) {
        proxy_pass $licensing;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite, never append: the licensing service rate-limits by the
        # first address in this header, so a client must not be able to set it.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Real-IP         $remote_addr;
        # nginx adds these to every response already; drop the service's copies
        # so each is sent once. Its Content-Security-Policy (frame-ancestors
        # 'none') and Cache-Control (no-store) are its own: nginx sends neither
        # on these paths (see the maps above), so they pass through untouched.
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_read_timeout 30s;
        client_max_body_size 256k;
        error_page 502 503 504 /licensing-unavailable.html;
    }

    # Container orchestrators want a cheap endpoint that does not read from disk.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Everything else is a file in the root: the pages, Astro's bundles under
    # /_astro/, the images under /assets/ (cached as the map above says),
    # robots.txt, the sitemap, and /.well-known/security.txt (RFC 9116);
    # nothing here hides dot-directories.
    location / {
        # Allow /products/readyroom as well as /products/readyroom.html.
        try_files $uri $uri.html $uri/ =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
    location = /licensing-unavailable.html {
        internal;
    }
}
