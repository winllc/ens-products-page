---
import { CONTACT_ENDPOINT, CONTACT_HONEYPOT, contactLimits, contactTopicList } from '../data/contact';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
    title="Contact"
    description="Contact ENS Solutions, LLC about ReadyRoom, CertAlert, RSA Operations Portal, Directory Services Portal or our IT services."
>
<section class="hero">
    <div class="wrap">
        <p class="eyebrow">Contact</p>
        <h1>Talk to ENS Solutions.</h1>
        <p class="lede">
            Questions about a product, a quote or a paid pilot, a demo against your own environment, or
            requirements you would like to see reflected in something we are building &mdash; send us a
            note.
        </p>
    </div>
</section>

<section class="section" aria-label="Contact form and details">
    <div class="wrap contact-layout">
        <!--
            The form posts to the licensing service, which stores the message, emails it to us and
            acknowledges it. The script posts it in place and shows the result here; without JavaScript
            the browser posts it and comes back to #sent. If the service can't be reached, the script
            falls back to composing an email in the visitor's own mail app.
        -->
        <form class="contact-form" id="contact-form" action={CONTACT_ENDPOINT} method="post"
              data-recipient="info@ens-solutions.com">
            <div class="form-sent callout callout--ok" id="sent" role="status" tabindex="-1">
                <p>
                    <strong>Thanks, we have your message.</strong> We will reply within one business day. A copy
                    is on its way to the address you gave.
                </p>
            </div>
            <div class="form-grid">
                <div class="field">
                    <label for="name">Name</label>
                    <input id="name" name="name" type="text" autocomplete="name" required maxlength={contactLimits.name}>
                </div>
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" autocomplete="email" required maxlength={contactLimits.email}>
                </div>
                <div class="field">
                    <label for="organization">Organization <span class="optional">optional</span></label>
                    <input id="organization" name="organization" type="text" autocomplete="organization" maxlength={contactLimits.organization}>
                </div>
                <div class="field">
                    <label for="phone">Phone <span class="optional">optional</span></label>
                    <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength={contactLimits.phone}>
                </div>
                <div class="field field--wide">
                    <label for="topic">What is this about?</label>
                    <select id="topic" name="topic" required>
                        {contactTopicList.map((t) => <option value={t}>{t}</option>)}
                    </select>
                </div>
                <div class="field field--wide">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" rows="7" required maxlength={contactLimits.message}
                              aria-describedby="message-hint"></textarea>
                    <p class="field-hint" id="message-hint">Up to 1,500 characters.</p>
                </div>
                <div class="field field--trap" aria-hidden="true">
                    <label for={CONTACT_HONEYPOT}>Leave this field empty</label>
                    <input id={CONTACT_HONEYPOT} name={CONTACT_HONEYPOT} type="text" tabindex="-1" autocomplete="off">
                </div>
            </div>

            <div class="btn-row">
                <button class="btn btn--primary" type="submit">Send message</button>
                <span class="btn-note">We reply within one business day.</span>
            </div>

            <p class="form-status" id="form-status" role="status" hidden></p>
        </form>

        <aside class="contact-aside" aria-labelledby="direct-heading">
            <h2 id="direct-heading">Reach us directly</h2>
            <dl class="contact-list">
                <div>
                    <dt>Email</dt>
                    <dd><a href="mailto:info@ens-solutions.com">info@ens-solutions.com</a></dd>
                </div>
                <div>
                    <dt>Phone</dt>
                    <dd><a href="tel:+13019254008">301-925-4008</a></dd>
                </div>
                <div>
                    <dt>Web</dt>
                    <dd><a href="https://ens-solutions.com/">ens-solutions.com</a></dd>
                </div>
                <div>
                    <dt>LinkedIn</dt>
                    <dd><a href="https://www.linkedin.com/company/ens-solutions-llc/">ENS Solutions, LLC</a></dd>
                </div>
            </dl>
            <p class="muted small">
                What you send is kept only so we can answer it, is emailed to us and acknowledged to you, and
                is not shared with anyone else. If the form can&rsquo;t reach us, it opens a draft in your
                own email app instead.
            </p>
        </aside>
    </div>
</section>

<script>
    import '../scripts/contact';
</script>
</BaseLayout>
