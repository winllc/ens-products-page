---
import { bundleDiscounts, pilot, supportTiers, thresholds } from '../data/pricing';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
import { docsUrl } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPercent, formatUSD, startingPrice } from '../lib/pricing';
import { jsonLd, organization, productList } from '../lib/structured-data';

const lowest = Math.min(...products.map((p) => startingPrice(p.id)));
const firstBundle = bundleDiscounts[0]!;
const topBundle = bundleDiscounts.at(-1)!;
const mission = supportTiers.at(-1)!;
---
<BaseLayout
    title="Products"
    description="Identity and accountability software from ENS Solutions, LLC — a service-disabled veteran-owned IT firm serving the DoD, the Intelligence Community and commercial customers. ReadyRoom, CertAlert, RSA Operations Portal and Directory Services Portal."
>
<script is:inline type="application/ld+json" slot="head" set:html={jsonLd([organization(), productList()])} />
<section class="hero">
    <div class="wrap">
        <p class="eyebrow">Essential Network Security Solutions &middot; Veteran-owned</p>
        <h1>Your essential IT partner, now in software you can deploy.</h1>
        <p class="lede">
            ENS Solutions is a service-disabled veteran-owned IT consulting and management firm
            supporting the Department of Defense, the Intelligence Community and commercial
            customers. Identity, credential and access management is at the core of that work,
            and our products package it for organizations that already run a directory and a
            certificate authority — who is present, which credentials are about to lapse, how people
            prove who they are, and how the directory itself is kept up to date.
        </p>
        <div class="btn-row">
            <a class="btn btn--primary" href="#products-heading">Explore the products</a>
            <a class="btn btn--ghost" href="/pricing.html">See pricing</a>
            <a class="btn btn--ghost" href={docsUrl()}>Documentation</a>
        </div>

        <dl class="facts">
            <div>
                <dt>Small business</dt>
                <dd>SDVOSB</dd>
            </div>
            <div>
                <dt>Facility clearance</dt>
                <dd>Top Secret</dd>
            </div>
            <div>
                <dt>CAGE</dt>
                <dd><span class="mono">72Z38</span></dd>
            </div>
            <div>
                <dt>UEI</dt>
                <dd><span class="mono">C2KVS6MK3JJ8</span></dd>
            </div>
        </dl>
    </div>
</section>

<section class="section" aria-labelledby="products-heading">
    <div class="wrap">
        <h2 id="products-heading">Products</h2>
        <p class="lede">
            {products.length} products, each running against the directory you already have. Take two or
            more and the suite discount applies to all of them.
        </p>
        <div class="product-grid">
            {products.map((p) => <ProductCard product={p.id} />)}
        </div>
        <p class="section-more">
            <a href="/trust.html">Signed releases with SBOMs, a hash-chained audit trail and our FIPS and STIG position: the trust page, for security reviewers &rarr;</a>
        </p>
    </div>
</section>

<section class="section" aria-labelledby="docs-heading">
    <div class="wrap">
        <div class="docs-band">
            <div>
                <h2 id="docs-heading">Read the documentation first</h2>
                <p>
                    Install, configuration, operator, administrator and user guides for every product,
                    published openly: see what running one involves before you talk to us.
                </p>
            </div>
            <ul class="docs-band-links">
                {products.map((p) => <li><a href={docsUrl(`${p.docsPath}/`)}>{p.name}</a></li>)}
            </ul>
            <a class="btn btn--primary" href={docsUrl()}>Open the documentation</a>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="pricing-heading">
    <div class="wrap">
        <h2 id="pricing-heading">Pricing you can see before you call</h2>
        <p class="lede">
            Annual subscriptions sized by your directory, with updates, patches and support included &mdash;
            or a perpetual license where your contract vehicle needs a one-time purchase.
        </p>
        <div class="feature-grid feature-grid--pairs">
            <div class="feature">
                <h3>From {formatUSD(lowest)} a year</h3>
                <p>
                    Smaller tiers fit under the {formatUSD(thresholds.microPurchase)} micro-purchase threshold
                    and can go on a government purchase card.
                </p>
            </div>
            <div class="feature">
                <h3>{formatPercent(firstBundle.rate)}&ndash;{formatPercent(topBundle.rate)} off the suite</h3>
                <p>Take two or more products and the discount comes off the sum of all of them.</p>
            </div>
            <div class="feature">
                <h3>{mission.name} support for DoD and IC</h3>
                <p>{mission.hours} coverage, {mission.response} response, cleared on-site support and releases on media for air-gapped networks.</p>
            </div>
            <div class="feature">
                <h3>A pilot that counts</h3>
                <p>A {pilot.days}-day paid pilot for {formatUSD(pilot.price)}, credited in full toward the first year.</p>
            </div>
        </div>
        <div class="btn-row">
            <a class="btn btn--primary" href="/pricing.html">See pricing</a>
            <a class="btn btn--ghost" href="/pricing.html#estimate">Build an estimate</a>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="company-heading">
    <div class="wrap">
        <h2 id="company-heading">Who we are</h2>
        <p class="lede">
            An agile technology consulting firm focused on IT innovation and management, with
            cleared staff and long-standing customer relationships across the mission community.
            The products on this site come from the same practice areas we deliver as services.
        </p>
        <div class="feature-grid">
            <div class="feature">
                <h3>Identity, credential &amp; access management</h3>
                <p>
                    Multi-factor authentication, public key infrastructure, privileged access
                    management and managed authentication services.
                </p>
            </div>
            <div class="feature">
                <h3>Software development</h3>
                <p>
                    Application and system design, product architecture and database engineering,
                    built on Java, Spring, Node.js and React.
                </p>
            </div>
            <div class="feature">
                <h3>Systems engineering &amp; security</h3>
                <p>
                    COTS integration, enterprise architecture, cyber and network security, service
                    desk and program management office support.
                </p>
            </div>
        </div>
        <p class="section-more">
            <a href="https://ens-solutions.com/">Full company profile and careers at ens-solutions.com &rarr;</a>
        </p>
    </div>
</section>

<section class="section" aria-labelledby="approach-heading">
    <div class="wrap">
        <h2 id="approach-heading">How we build</h2>
        <div class="feature-grid">
            <div class="feature">
                <h3>The directory stays the source of truth</h3>
                <p>
                    People, groups and org structure come from LDAP. Our databases store only what
                    the directory cannot — records, roles, permissions and history.
                </p>
            </div>
            <div class="feature">
                <h3>Certificate-first authentication</h3>
                <p>
                    Mutual TLS with X.509 client certificates where the environment supports it,
                    with directory username and password as the fallback.
                </p>
            </div>
            <div class="feature">
                <h3>Deploys where you already are</h3>
                <p>
                    Containerized, self-hosted, and configured through environment variables and
                    external config rather than edits to a shipped file.
                </p>
            </div>
        </div>
    </div>
</section>
</BaseLayout>
