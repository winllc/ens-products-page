---
import CapabilityTable from '../../components/CapabilityTable.astro';
import FactTable from '../../components/FactTable.astro';
import ProductPricing from '../../components/ProductPricing.astro';
import { docsUrl } from '../../data/site';
import { formatUSD, startingPrice } from '../../lib/pricing';
import CompliancePack from '../../components/CompliancePack.astro';
import ProductLayout from '../../layouts/ProductLayout.astro';

const docs = (page: string) => docsUrl(`readyroom/${page}`);
---
<ProductLayout
    product="readyroom"
    description="ReadyRoom turns the Windows sign-ins your people already make into daily attendance, accountability and absence alerts, organized by the LDAP or Active Directory you already run. Leave approvals, PDF, CSV and Excel reports, CAC/PIV or single sign-on, a read-only API and webhooks, a hash-chained audit trail; Compose package or Helm chart."
    headline="Know who&rsquo;s in, without a sign-in sheet."
    sections={[
        { id: 'how-heading', label: 'How it works' },
        { id: 'screens-heading', label: 'Screens' },
        { id: 'status-heading', label: 'Statuses' },
        { id: 'roles-heading', label: 'Roles' },
        { id: 'alerts-heading', label: 'Absence alerts' },
        { id: 'features-heading', label: 'More features' },
        { id: 'security-heading', label: 'Security' },
        { id: 'platform-heading', label: 'Security and integrations' },
        { id: 'scope-heading', label: 'Today and not yet' },
        { id: 'artifacts-heading', label: 'Documentation pack' },
        { id: 'tech-heading', label: 'Requirements' },
        { id: 'pricing-heading', label: 'Pricing' },
    ]}
>
    <img slot="logo" class="product-logo product-logo--ink" src="/assets/img/brand/readyroom-logo.png" width="480" height="280"
         alt="ReadyRoom: Workforce Accountability">
    <p class="lede" slot="lede">
        ReadyRoom turns the Windows sign-ins your people already make into a daily picture of
        who is in, who is away, and who hasn&rsquo;t been accounted for &mdash; organized by the
        directory you already run, and escalated to the right manager when someone doesn&rsquo;t
        show.
    </p>
    <!-- Illustration of the manager's team view. Not live data. -->
    <figure slot="aside" class="mock" aria-hidden="true">
        <div class="mock-head">
            <span class="mock-title">My team</span>
            <span class="mock-sub">12 direct reports</span>
        </div>
        <div class="mock-label">Accounted for today</div>
        <div class="mock-figure">92%</div>
        <div class="mock-bar">
            <span class="seg seg--in"></span><span class="seg seg--wfh"></span><span class="seg seg--tdy"></span><span class="seg seg--none"></span>
        </div>
        <ul class="mock-legend">
            <li><span class="dot dot--in"></span>Checked in<b>8</b></li>
            <li><span class="dot dot--wfh"></span>Work from home<b>2</b></li>
            <li><span class="dot dot--tdy"></span>TDY<b>1</b></li>
            <li><span class="dot dot--none"></span>Unaccounted for<b>1</b></li>
        </ul>
        <div class="mock-row">
            <span>Not in yet &middot; expected 08:00</span>
            <span class="status status--late">Late</span>
        </div>
    </figure>

<section class="section" aria-labelledby="how-heading">
    <div class="wrap">
        <h2 id="how-heading">How it works</h2>
        <p class="lede">Nobody has to remember to check in.</p>
        <ol class="flow-steps">
            <li>
                <strong>People sign in to Windows as usual.</strong> A lightweight PowerShell agent, run
                by five Windows scheduled tasks, reports sign-in, screen lock, screen unlock, session
                disconnect and sign-out. Once IT has installed it there is nothing for anyone to open or click.
            </li>
            <li>
                <strong>Events become a working day.</strong> The first sign-in or unlock of the day
                counts as arrival. Locks, returns and departures fill in the rest, alongside any status
                someone has put on their calendar, such as work from home or leave.
            </li>
            <li>
                <strong>The directory supplies the people.</strong> Users, groups, managers and org
                structure are read from LDAP or Active Directory, so there is no second roster to keep
                in step.
            </li>
            <li>
                <strong>Everyone sees what they need.</strong> Individuals see their own day, managers
                see the people who report to them, and leadership sees organization-wide figures.
            </li>
        </ol>
    </div>
</section>

<section class="section" aria-labelledby="screens-heading">
    <div class="wrap">
        <h2 id="screens-heading">See it in use</h2>
        <p class="lede">Screenshots of ReadyRoom running against a demo directory with sample people and data. Select one to see it full size.</p>
        <div class="shot-grid">
            <figure class="shot shot--wide">
                <a href="/assets/img/screens/readyroom-home.jpg" class="shot-link" target="_blank" rel="noopener">
                    <picture>
                        <source media="(max-width: 640px)" srcset="/assets/img/screens/readyroom-home-mobile.jpg" width="640" height="583">
                        <img src="/assets/img/screens/readyroom-home.jpg" width="1440" height="852" loading="lazy" decoding="async"
                             alt="ReadyRoom home page for a manager: her own status, checked in since 08:00; her team 86% accounted for, with one report, Carol Clark, not in yet.">
                    </picture>
                    <span class="visually-hidden"> (opens full size in a new tab)</span>
                </a>
                <figcaption><strong>Home.</strong> A manager sees her own day and her team&rsquo;s: six of seven reports accounted for, and who isn&rsquo;t in yet.</figcaption>
            </figure>
            <figure class="shot">
                <a href="/assets/img/screens/readyroom-metrics.jpg" class="shot-link" target="_blank" rel="noopener">
                    <picture>
                        <source media="(max-width: 640px)" srcset="/assets/img/screens/readyroom-metrics-mobile.jpg" width="380" height="590">
                        <img src="/assets/img/screens/readyroom-metrics.jpg" width="1440" height="852" loading="lazy" decoding="async"
                             alt="ReadyRoom metrics page: 88% of expected users accounted for, the mix of statuses, agent coverage, a pie chart of current statuses and a timeline of today&rsquo;s check-ins, locks and check-outs.">
                    </picture>
                    <span class="visually-hidden"> (opens full size in a new tab)</span>
                </a>
                <figcaption><strong>Metrics.</strong> Organization-wide counts: who is accounted for, the status mix, agent coverage, and today&rsquo;s activity.</figcaption>
            </figure>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="status-heading">
    <div class="wrap">
        <h2 id="status-heading">A status for everyone, every day</h2>
        <div class="split">
            <div>
                <h3>From the workstation</h3>
                <ul class="status-list">
                    <li><span class="status status--in">In</span>Signed in and at the workstation.</li>
                    <li><span class="status status--away">Away</span>Screen locked.</li>
                    <li><span class="status status--out">Out</span>Signed out for the day.</li>
                    <li><span class="status status--none">None</span>No activity recorded yet today.</li>
                </ul>
            </div>
            <div>
                <h3>From the calendar</h3>
                <p class="muted">
                    People drag across days on their calendar to set a status ahead of time, and it is
                    shown in place of workstation activity &mdash; so someone who is TDY is accounted for,
                    not missing.
                </p>
                <ul class="tag-list">
                    <li>Work from home</li>
                    <li>TDY</li>
                    <li>Out of office</li>
                    <li>Scheduled leave</li>
                    <li>Late arrival</li>
                    <li>Early leave</li>
                </ul>
                <p class="muted small">
                    A late arrival or early leave is set by the person; a status that excuses an absence,
                    such as leave, telework or TDY, is requested and approved by their manager or a
                    delegate on the Approvals page. Managers can also record unscheduled leave and
                    excused or unexcused absences when they follow up on an alert.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="roles-heading">
    <div class="wrap">
        <h2 id="roles-heading">Built for the whole chain of accountability</h2>
        <div class="card-grid">
            <article class="card">
                <p class="card-kicker">Individuals</p>
                <h3>Their own day, at a glance</h3>
                <ul class="ticks">
                    <li>Today&rsquo;s status, the last 30 days and what&rsquo;s coming up</li>
                    <li>Set a usual login time, or let their average arrival stand in</li>
                    <li>Name additional managers who should hear if they&rsquo;re not in</li>
                    <li>Leave notes for the people who look them up</li>
                </ul>
            </article>
            <article class="card">
                <p class="card-kicker">Managers</p>
                <h3>Who&rsquo;s accounted for on the team</h3>
                <ul class="ticks">
                    <li>Accounted-for rate and who isn&rsquo;t in yet, on the home page</li>
                    <li>Absence alerts waiting for a response, by email and in-app</li>
                    <li>Direct reports from the directory in one table</li>
                    <li>Group rollups and day-by-day, person-by-person reports over a date range</li>
                </ul>
            </article>
            <article class="card">
                <p class="card-kicker">Leadership &amp; administrators</p>
                <h3>The organization in numbers</h3>
                <ul class="ticks">
                    <li>Accounted-for rate, status mix and activity through the day</li>
                    <li>Breakdowns by organization, employee type, location and branch</li>
                    <li>Workstation agent coverage, so a silent agent isn&rsquo;t mistaken for an absence</li>
                    <li>Organization calendar and holidays, and a date picker to see how any past day stood</li>
                </ul>
            </article>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="alerts-heading">
    <div class="wrap">
        <h2 id="alerts-heading">Absence alerts that hold people to the right time</h2>
        <p class="lede">
            If someone hasn&rsquo;t checked in by their expected time plus a configurable grace period,
            their managers are notified by email and under the bell in the app, and can record what
            happened. The expected time is worked out the same way everywhere it appears, so what a
            person is told matches what they are held to.
        </p>
        <ol class="rule-steps">
            <li>
                <span class="rule-rank">1st</span>
                <div><strong>A late arrival</strong> they entered for today</div>
            </li>
            <li>
                <span class="rule-rank">2nd</span>
                <div><strong>Their preferred login time</strong> from their profile</div>
            </li>
            <li>
                <span class="rule-rank">3rd</span>
                <div><strong>Their average arrival</strong> from past check-ins</div>
            </li>
        </ol>
        <div class="callout">
            <p>
                <strong>No alerts for days nobody is expected.</strong> Weekends and organization
                holidays are skipped, as are days covered by an excused status, and nobody is alerted
                about twice in one day.
            </p>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="features-heading">
    <div class="wrap">
        <h2 id="features-heading">Also in the box</h2>
        <div class="feature-grid feature-grid--pairs">
            <div class="feature">
                <h3>Idle sessions close themselves</h3>
                <p>
                    A scheduled job checks out sessions left open past a configurable idle threshold, so a
                    forgotten sign-out does not become a 14-hour day.
                </p>
            </div>
            <div class="feature">
                <h3>Org chart from the directory</h3>
                <p>
                    Hierarchy is derived from a flat LDAP attribute &mdash; <code>RYS34B</code> becomes
                    RYS &rarr; 34 &rarr; B by default &mdash; with regex rules in Settings for codes that
                    don&rsquo;t fit.
                </p>
            </div>
            <div class="feature">
                <h3>Groups and search</h3>
                <p>
                    Browse the groups you&rsquo;re allowed to see, star favorites to filter down to them, and
                    find anyone by name.
                </p>
            </div>
            <div class="feature">
                <h3>Classification banners</h3>
                <p>
                    Configurable banner text and colour across the top and bottom of every page, for
                    deployments that require a visible handling marking.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="security-heading">
    <div class="wrap">
        <h2 id="security-heading">Security and privacy</h2>
        <p class="lede">Designed for environments that take identity seriously.</p>
        <div class="feature-grid">
            <div class="feature">
                <h3>Certificate-first sign-in</h3>
                <p>
                    Mutual TLS with X.509 client certificates, resolving the full subject DN against the
                    directory. Browsers without a certificate fall back to an LDAP-validated form login,
                    or to single sign-on through your identity provider.
                </p>
            </div>
            <div class="feature">
                <h3>Optional Windows sign-in</h3>
                <p>
                    On domain-joined PCs the agent can check in with the user&rsquo;s Kerberos ticket instead
                    of, or ahead of, a certificate. Off by default; certificates keep working unchanged.
                </p>
            </div>
            <div class="feature">
                <h3>Who can see whom</h3>
                <p>
                    User, manager and administrator roles, plus per-group grants where a role is too coarse,
                    so a manager sees exactly the groups they are entitled to.
                </p>
            </div>
            <div class="feature">
                <h3>Counts, not names, in metrics</h3>
                <p>
                    Organization-wide figures are aggregates and never list individuals.
                </p>
            </div>
            <div class="feature">
                <h3>Your data stays yours</h3>
                <p>
                    Self-hosted. The directory stays the source of truth, and attendance records live in
                    your own PostgreSQL database.
                </p>
            </div>
        </div>
        <div class="callout">
            <p>
                <strong>One deliberate exception.</strong> Sign-out runs after the user profile &mdash; and
                with it their certificate store &mdash; is already gone, so it cannot authenticate. Sign-in
                caches the server-issued session identifier and sign-out echoes it back, which lets the
                server recover the identity without a certificate.
            </p>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="platform-heading">
    <div class="wrap">
        <h2 id="platform-heading">Security and integrations</h2>
        <p class="lede">
            What a security reviewer or an integrator will ask about, in one place. Each row links the
            documentation page that describes it in full.
        </p>
        <FactTable
            caption="ReadyRoom security and integration summary"
            rows={[
                {
                    label: 'Sign-in',
                    detail: 'Mutual TLS with X.509 client certificates (a CAC or PIV card) resolved against the directory; the directory password as the fallback; or single sign-on by OpenID Connect or SAML&nbsp;2.0, with a Microsoft Entra ID set-up documented. The workstation agent checks in with a certificate or, optionally, a Kerberos ticket.',
                    docs: { href: docs('single-sign-on/'), label: 'Single sign-on' },
                },
                {
                    label: 'Roles',
                    detail: 'User, manager and administrator, with per-group grants and extra group managers where a role is too coarse, and delegates who approve statuses on a manager&rsquo;s behalf.',
                    docs: { href: docs('security/'), label: 'Security' },
                },
                {
                    label: 'Public API',
                    detail: 'A read-only REST API at <span class="mono">/api/v1</span> with an OpenAPI document, called with scoped API tokens (<span class="mono">people:read</span>, <span class="mono">attendance:read</span>, <span class="mono">absences:read</span>) that expire and carry their own rate limit.',
                    docs: { href: docs('api-reference/'), label: 'API reference' },
                },
                {
                    label: 'Webhooks',
                    detail: 'HMAC-signed webhooks for absence alerts and status changes, so another system hears the moment someone is late or a status changes.',
                    docs: { href: docs('webhooks/'), label: 'Webhooks' },
                },
                {
                    label: 'Reports and exports',
                    detail: 'Group reports as PDF, CSV or Excel, people lists, and scheduled e-mailed reports, with each person&rsquo;s times in their own or their site&rsquo;s time zone.',
                    docs: { href: docs('exports/'), label: 'Reports, exports and time zones' },
                },
                {
                    label: 'Privacy and retention',
                    detail: 'What coworkers see of each other is configurable. Old check-ins and statuses are summarised by month and deleted after a set number of days; everyone can download their own data, and administrators export or erase a person&rsquo;s. A page written for a DPIA or a works council.',
                    docs: { href: docs('privacy/'), label: 'Privacy, DPIA and works council' },
                },
                {
                    label: 'High availability',
                    detail: 'Several replicas with the Helm chart. Sessions, job locks, sign-in requests in progress and the license state live in PostgreSQL, so each job runs once and two replicas keep workstation events flowing through an upgrade.',
                    docs: { href: docs('availability-and-sizing/'), label: 'Sizing, availability and recovery' },
                },
                {
                    label: 'Audit trail',
                    detail: 'Sign-ins, refusals, settings, status requests, exports and retention runs in the hash-chained <span class="mono">ens-audit/1</span> trail: searchable and verifiable in the app, exported as CSV or NDJSON, forwarded to Splunk HEC or syslog, or pulled by your SIEM through an API token.',
                    docs: { href: docsUrl('audit-logging/'), label: 'Audit logging' },
                },
                {
                    label: 'Observability',
                    detail: 'Prometheus metrics and health probes on a separate management port, and JSON logs in Elastic Common Schema.',
                    docs: { href: docs('operator-guide/'), label: 'Operations' },
                },
                {
                    label: 'Deployment',
                    detail: 'A release package for Docker or Podman Compose (podman-compose 1.0.6 or newer) with PostgreSQL included and the Windows agent alongside, or a Helm chart for Kubernetes and OpenShift. The image is built on Red Hat UBI&nbsp;9; image and chart are signed with cosign by digest, with an SPDX SBOM in the download and attested on the image.',
                    docs: { href: docs('install/'), label: 'Install guide' },
                },
                {
                    label: 'Windows agent',
                    detail: 'One PowerShell script run by five scheduled tasks (sign-in, lock, unlock, disconnect and sign-out), registered by an installer script and removed by the same script. Windows only.',
                    docs: { href: docs('windows-client/'), label: 'Windows client' },
                },
                {
                    label: 'STIG-style controls',
                    detail: 'The ENS platform baseline: a notice-and-consent banner, idle, administrator and absolute session timeouts and a sessions-per-user limit, security headers and CSRF protection, client-certificate revocation checking and allowed issuers, and the Helm chart&rsquo;s non-root, read-only containers.',
                    docs: { href: docs('fips-and-stig/'), label: 'FIPS 140-3 and DISA STIG' },
                },
                {
                    label: 'FIPS 140-3',
                    detail: 'Runs on FIPS-mode RHEL or OpenShift hosts, taking its cryptography from Red Hat&rsquo;s OpenJDK, and the license check accepts a license&rsquo;s ECDSA P-256 co-signature where Ed25519 is unavailable. ENS supplies no validated cryptographic module and claims no validation; the server, the Windows agent under Windows&rsquo; FIPS policy and Kerberos sign-in have not yet been tested in FIPS mode.',
                    docs: { href: docsUrl('fips-and-stig/'), label: 'FIPS position' },
                },
                {
                    label: 'Accessibility',
                    detail: 'Targets WCAG 2.1 AA (Section 508). Every push runs axe-core through a real browser against the main pages, at desktop and phone widths and as an administrator, a manager and a user, and fails on a serious or critical violation. A self-audit (which lists the remaining keyboard gaps) and a draft VPAT are available on request; conformance is not yet claimed.',
                    docs: { href: docs('accessibility/'), label: 'Accessibility' },
                },
            ]}
        />
    </div>
</section>

<section class="section" aria-labelledby="scope-heading">
    <div class="wrap">
        <h2 id="scope-heading">What it does, and what it does not yet</h2>
        <p class="lede">
            For your shortlist: what is in the product today, what is there in part, and what it does
            not do yet. &ldquo;Not yet&rdquo; means not in the current release; ask us about the roadmap.
        </p>
        <CapabilityTable
            caption="ReadyRoom capabilities today"
            rows={[
                { label: 'Automatic presence from workstation activity', status: 'included', note: 'Sign-in, lock, unlock, disconnect and sign-out, tied to the Windows session. Windows only.' },
                { label: 'Leave and absence approvals', status: 'included', note: 'Statuses that excuse an absence are requested, then approved by a manager or delegate.' },
                { label: 'Reports and exports', status: 'included', note: 'PDF, CSV and Excel, scheduled e-mailed reports, time zones.' },
                { label: 'Single sign-on and smart cards', status: 'included', note: 'OpenID Connect and SAML 2.0 beside CAC/PIV and the directory password.' },
                { label: 'High availability', status: 'included', note: 'Several replicas with the Helm chart; rolling updates.' },
                { label: 'Privacy controls and retention', status: 'included', note: 'Visibility policy, purge with monthly roll-ups, export and erasure.' },
                { label: 'Audit and SIEM', status: 'included', note: 'Hash-chained trail to Splunk, syslog or a pull API.' },
                { label: 'Integrations', status: 'partial', note: 'A read-only API and two webhook events; nothing writes in, and there is no HRIS or calendar feed.' },
                { label: 'Agent deployment', status: 'partial', note: 'A PowerShell installer registers the scheduled tasks; no MSI package for Intune, Group Policy or SCCM yet.' },
                { label: 'Notifications', status: 'partial', note: 'E-mail, in-app and webhooks; Teams, Slack or SMS need a webhook receiver on your side.' },
                { label: 'Proof for accreditation', status: 'partial', note: 'FIPS and STIG settings documented; no FIPS-mode test run yet, and the VPAT is a draft.' },
                { label: 'Manual check-in (web, mobile, kiosk)', status: 'not-yet', note: 'People without a Windows workstation are accounted for only through calendar statuses.' },
                { label: 'Emergency muster and roll call', status: 'not-yet', note: 'No muster event, board or &ldquo;I&rsquo;m safe&rdquo; response.' },
                { label: 'macOS and Linux agents', status: 'not-yet', note: 'The agent is PowerShell on Windows.' },
            ]}
        />
    </div>
</section>

<CompliancePack product="readyroom" />

<section class="section" aria-labelledby="tech-heading">
    <div class="wrap">
        <h2 id="tech-heading">What you need to run it</h2>
        <div class="table-scroll">
            <table>
                <caption class="visually-hidden">ReadyRoom technical summary</caption>
                <thead>
                <tr>
                    <th scope="col">Component</th>
                    <th scope="col">Detail</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <th scope="row">Server</th>
                    <td>Spring Boot 4 on Java 21 with a Thymeleaf web UI, shipped as a container on Red Hat UBI 9</td>
                </tr>
                <tr>
                    <th scope="row">Deployment</th>
                    <td>A release package for Docker or Podman Compose, or a Helm chart for Kubernetes and OpenShift; signed images with an SBOM</td>
                </tr>
                <tr>
                    <th scope="row">Directory</th>
                    <td>LDAP / LDAPS or Active Directory, with pooled connections and paged searches for large directories</td>
                </tr>
                <tr>
                    <th scope="row">Database</th>
                    <td>PostgreSQL for check-ins, statuses, roles, permissions, notes and calendar events</td>
                </tr>
                <tr>
                    <th scope="row">Workstations</th>
                    <td>Windows with PowerShell 5.1; one install script registers the agent&rsquo;s five scheduled tasks</td>
                </tr>
                <tr>
                    <th scope="row">Authentication</th>
                    <td>A certificate authority for client certificates, or an OpenID Connect or SAML 2.0 identity provider, with the directory password as the fallback; optionally an AD service account and keytab for Windows sign-in by the agent</td>
                </tr>
                <tr>
                    <th scope="row">Email</th>
                    <td>An SMTP relay for absence notifications</td>
                </tr>
                <tr>
                    <th scope="row">Scale</th>
                    <td>Query performance measured against a seeded 5,000-user, 90-day dataset of about 1.2 million check-in records</td>
                </tr>
                <tr>
                    <th scope="row">Configuration</th>
                    <td>Environment variables or external config &mdash; no edits to a shipped file; health probes and Prometheus metrics on a management port</td>
                </tr>
                </tbody>
            </table>
        </div>

        <div class="callout">
            <p>
                Want to see ReadyRoom against your directory?
                <a href="/contact.html?product=readyroom">Get in touch</a> or email
                <a href="mailto:info@ens-solutions.com">info@ens-solutions.com</a>.
            </p>
        </div>
    </div>
</section>

<ProductPricing
    product="readyroom"
    lede={`Annual subscriptions from ${formatUSD(startingPrice('readyroom'))} a year, sized by the people ReadyRoom tracks. Updates, security patches and business-hours support are included.`}
/>
</ProductLayout>
