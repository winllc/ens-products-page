---
import CapabilityTable from '../../components/CapabilityTable.astro';
import FactTable from '../../components/FactTable.astro';
import ProductPricing from '../../components/ProductPricing.astro';
import { enterpriseCertificatePlatformRange } from '../../data/pricing';
import { docsUrl } from '../../data/site';
import { formatUSD } from '../../lib/pricing';
import ProductLayout from '../../layouts/ProductLayout.astro';

const docs = (page: string) => docsUrl(`cert-alert/${page}`);
---
<ProductLayout
    product="certalert"
    description="CertAlert indexes every certificate your LDAP directory publishes, alerts the points of contact before one expires by email, Slack or Teams, checks revocation and what servers actually serve, and exports the inventory. CAC/PIV, password or single sign-on, a REST API, a hash-chained audit trail, and a Helm chart or Compose package. From ENS Solutions."
    headline="Every certificate in your directory, and who answers for it."
    sections={[
        { id: 'how-heading', label: 'How it works' },
        { id: 'screens-heading', label: 'Screens' },
        { id: 'capabilities-heading', label: 'Features' },
        { id: 'beyond-heading', label: 'Beyond expiry' },
        { id: 'security-heading', label: 'Accredited networks' },
        { id: 'platform-heading', label: 'Security and integrations' },
        { id: 'scope-heading', label: 'Today and not yet' },
        { id: 'tech-heading', label: 'Requirements' },
        { id: 'pricing-heading', label: 'Pricing' },
    ]}
>
    <picture slot="logo">
        <source srcset="/assets/img/brand/certalert-logo-white.png" media="(prefers-color-scheme: dark)" width="610" height="160">
        <img class="product-logo product-logo--wide" src="/assets/img/brand/certalert-logo.png" width="610" height="160" alt="CertAlert">
    </picture>
    <p class="lede" slot="lede">
        CertAlert reads the people and servers out of your LDAP directory, parses every certificate
        they publish, and puts the results in searchable tables. It knows the points of contact for
        each server, alerts them before a certificate expires, and reports on the whole
        directory &mdash; so an expiring certificate is a planned renewal, not a surprise.
    </p>

<section class="section" aria-labelledby="how-heading">
    <div class="wrap">
        <h2 id="how-heading">How it works</h2>
        <p class="lede">The directory is the source of truth. CertAlert is the index over it.</p>
        <ol class="flow-steps">
            <li>
                <strong>Scheduled sweeps read the directory.</strong> Nightly jobs read every person and
                every server with paged searches, so large directories are read completely rather than
                stopping at the server&rsquo;s size limit. Where the directory publishes a changelog,
                CertAlert follows it too and picks up a replaced certificate within seconds instead of
                overnight.
            </li>
            <li>
                <strong>Every certificate is parsed once and cached.</strong> Subject, issuer, serial,
                validity, key and signature algorithms, subject alternative names and a SHA-256
                fingerprint are stored, so no question needs the directory again. A re-sync of an
                unchanged directory writes nothing.
            </li>
            <li>
                <strong>Status is kept current.</strong> Every hour, each certificate is checked again as
                valid, expiring soon, critical or expired, and each person and server is rolled up to
                the certificates it still depends on.
            </li>
            <li>
                <strong>The right people hear about it.</strong> Points of contact get an in-app
                notification when a certificate changes state, and a daily email round-up of what is
                coming due.
            </li>
        </ol>
    </div>
</section>

<section class="section" aria-labelledby="screens-heading">
    <div class="wrap">
        <h2 id="screens-heading">See it in use</h2>
        <p class="lede">Screenshots of CertAlert running against a demo directory with sample people and data. Select one to see it full size.</p>
        <div class="shot-grid">
            <figure class="shot shot--wide">
                <a href="/assets/img/screens/certalert-servers.jpg" class="shot-link" target="_blank" rel="noopener">
                    <picture>
                        <source media="(max-width: 640px)" srcset="/assets/img/screens/certalert-servers-mobile.jpg" width="640" height="290">
                        <img src="/assets/img/screens/certalert-servers.jpg" width="1440" height="1060" loading="lazy" decoding="async"
                             alt="CertAlert servers table: totals of valid, expiring and expired certificates, filters, and a server named mail01 expanded to show its points of contact, directory attributes and certificate details.">
                    </picture>
                    <span class="visually-hidden"> (opens full size in a new tab)</span>
                </a>
                <figcaption><strong>Servers.</strong> Filter by certificate status, expiry window, contact or project, and expand a server for its points of contact and certificate.</figcaption>
            </figure>
            <figure class="shot">
                <a href="/assets/img/screens/certalert-metrics.jpg" class="shot-link" target="_blank" rel="noopener">
                    <picture>
                        <source media="(max-width: 640px)" srcset="/assets/img/screens/certalert-metrics-mobile.jpg" width="700" height="460">
                        <img src="/assets/img/screens/certalert-metrics.jpg" width="1440" height="900" loading="lazy" decoding="async"
                             alt="CertAlert metrics page: 13 certificates cached, 4 valid, 6 expiring soon and 3 expired, with a chart of certificates issued against those expiring over two years.">
                    </picture>
                    <span class="visually-hidden"> (opens full size in a new tab)</span>
                </a>
                <figcaption><strong>Metrics.</strong> What the directory publishes, what falls due, and renewals that haven&rsquo;t happened yet.</figcaption>
            </figure>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="capabilities-heading">
    <div class="wrap">
        <h2 id="capabilities-heading">What it does</h2>
        <div class="card-grid card-grid--pairs">
            <article class="card">
                <p class="card-kicker">Search tables</p>
                <h3>People and servers, filtered any way</h3>
                <p>
                    Separate tables for users and servers, sorted and filtered by certificate status,
                    expiry window, point of contact or project, or narrowed to &ldquo;only mine.&rdquo; Expand a row for its
                    certificates, contacts and recent history.
                </p>
            </article>
            <article class="card">
                <p class="card-kicker">Points of contact</p>
                <h3>A named owner for every server</h3>
                <p>
                    The directory&rsquo;s own <span class="mono">serverPOC</span> is read and matched to
                    people. Contacts can also be added in CertAlert, and a nightly sync never overwrites
                    them. From any person you can list every server they are responsible for.
                </p>
            </article>
            <article class="card">
                <p class="card-kicker">Notifications</p>
                <h3>One alert, to everyone who needs it</h3>
                <p>
                    Status-change notices appear under the bell in the app, and a daily expiry round-up
                    is emailed to each contact, one message per person rather than one per certificate.
                    A dry run shows what would be sent, and administrators can use their own email
                    templates.
                </p>
            </article>
            <article class="card">
                <p class="card-kicker">Metrics</p>
                <h3>Where the organization stands</h3>
                <p>
                    What is due in 7, 30 and 90 days, key sizes and signature algorithms in use, issuance
                    trends and issuing authorities, revocation counts, and how many people have been told.
                </p>
            </article>
            <article class="card">
                <p class="card-kicker">Projects</p>
                <h3>Group what gets renewed together</h3>
                <p>
                    Group servers and people into a project, so &ldquo;forty certificates expire this
                    month&rdquo; becomes &ldquo;the payroll migration expires this month.&rdquo; Both tables
                    filter by project.
                </p>
            </article>
            <article class="card">
                <p class="card-kicker">Audit trail</p>
                <h3>What happened, and who did it</h3>
                <p>
                    Each entry has a history: when it was discovered, which certificates were published
                    or withdrawn, status changes, alerts sent or failed, and edits to its contacts.
                </p>
            </article>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="beyond-heading">
    <div class="wrap">
        <h2 id="beyond-heading">Beyond the expiry date</h2>
        <div class="feature-grid">
            <div class="feature">
                <h3>Revocation checks</h3>
                <p>
                    A scheduled job asks the issuing authorities which certificates they have revoked.
                    A certificate reported stolen in March is flagged, even though its expiry date
                    is still years away.
                </p>
            </div>
            <div class="feature">
                <h3>What the server is actually serving</h3>
                <p>
                    A server&rsquo;s endpoint check connects over TLS and compares the certificate it
                    presents with the newest one in the directory. This catches a renewal that was issued
                    but never installed.
                </p>
            </div>
            <div class="feature">
                <h3>Risky names</h3>
                <p>
                    Wildcards, broad wildcards such as <span class="mono">*.gov</span>, certificates with
                    many names or domains, and bare hostnames are flagged so they can be reviewed.
                </p>
            </div>
            <div class="feature">
                <h3>Directory clean-up</h3>
                <p>
                    An optional job removes certificates from the directory once they have been expired
                    or revoked for a set time, so other systems that read the directory stop finding them.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="security-heading">
    <div class="wrap">
        <h2 id="security-heading">Built for accredited networks</h2>
        <div class="feature-grid">
            <div class="feature">
                <h3>Certificate sign-in, matched exactly</h3>
                <p>
                    A client certificate is matched by its SHA-256 fingerprint against the certificates
                    the directory publishes for that person, not by pattern-matching a subject name.
                    Removing the certificate from the directory removes the access. Directory password
                    sign-in and single sign-on through your identity provider are the alternatives.
                </p>
            </div>
            <div class="feature">
                <h3>Built for the IC directory schema</h3>
                <p>
                    Built for the IC IdAM Full Service Directory object classes
                    (<span class="mono">icOrgPerson</span>, <span class="mono">icOrgServer</span>), and
                    every attribute name can be configured for other schemas.
                </p>
            </div>
            <div class="feature">
                <h3>Classification banners</h3>
                <p>
                    Optional fixed banners at the top and bottom of every page, for deployments that
                    must show the classification of what is on screen.
                </p>
            </div>
            <div class="feature">
                <h3>No outside dependencies</h3>
                <p>
                    The whole interface is served from the application itself, with no CDN, so it
                    works on networks that have no internet route.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="platform-heading">
    <div class="wrap">
        <h2 id="platform-heading">Security and integrations</h2>
        <p class="lede">
            What a security reviewer or an integrator will ask about, in one place. Each row links the
            documentation page that describes it in full.
        </p>
        <FactTable
            caption="CertAlert security and integration summary"
            rows={[
                {
                    label: 'Sign-in',
                    detail: 'X.509 client certificates (a CAC or PIV card) matched by fingerprint against the directory, optionally checked for revocation at sign-in or forwarded by a TLS-terminating proxy; the directory password, by LDAP bind; or single sign-on by OpenID Connect or SAML&nbsp;2.0, with Entra ID, Okta and AD&nbsp;FS set-ups documented.',
                    docs: { href: docs('single-sign-on/'), label: 'Single sign-on and roles' },
                },
                {
                    label: 'Roles',
                    detail: 'Reader, a read-only <strong>auditor</strong> who sees everything and changes nothing, and administrator, assigned from configuration, directory groups or the identity provider&rsquo;s groups.',
                    docs: { href: docs('security/'), label: 'Security' },
                },
                {
                    label: 'Public API',
                    detail: 'A versioned REST API at <span class="mono">/api/v1</span> with an OpenAPI 3.1 document, called with scoped, expiring API tokens that never exceed their creator&rsquo;s own role, rate-limited per token.',
                    docs: { href: docs('api-reference/'), label: 'API reference' },
                },
                {
                    label: 'Webhooks',
                    detail: 'HMAC-signed webhooks for expiry alerts and job results, delivered as plain JSON, a Slack message or a Microsoft Teams card.',
                    docs: { href: docs('webhooks/'), label: 'Webhooks' },
                },
                {
                    label: 'Exports and reports',
                    detail: 'The Certificates page filters by key algorithm and size, hash algorithm and issuer, exports CSV or Excel, keeps saved views, assigns points of contact in bulk and e-mails scheduled reports.',
                    docs: { href: docs('exports-and-reports/'), label: 'Exports and reports' },
                },
                {
                    label: 'High availability',
                    detail: 'Several replicas with the Helm chart. Sessions, job locks, sign-in requests in progress and the license state live in PostgreSQL, so each scheduled job runs once and a rolling update signs nobody out.',
                    docs: { href: docs('availability-and-sizing/'), label: 'Sizing, availability and recovery' },
                },
                {
                    label: 'Audit trail',
                    detail: 'Every sign-in, refusal, setting, job run and change to an entry in the hash-chained <span class="mono">ens-audit/1</span> trail: searchable and verifiable in the app, exported as CSV or NDJSON, forwarded to Splunk HEC or syslog, or pulled by your SIEM through an API token.',
                    docs: { href: docsUrl('audit-logging/'), label: 'Audit logging' },
                },
                {
                    label: 'Observability',
                    detail: 'Prometheus metrics, liveness and readiness probes on a separate management port, and JSON logs in Elastic Common Schema.',
                    docs: { href: docs('operator-guide/'), label: 'Operator guide' },
                },
                {
                    label: 'Deployment',
                    detail: 'A release package for Docker or Podman Compose (podman-compose 1.0.6 or newer) with PostgreSQL included, or a Helm chart for Kubernetes and OpenShift. Images are built on Red Hat UBI&nbsp;9; the images and the chart are signed with cosign by digest, with an SPDX SBOM in the download and attested on the image.',
                    docs: { href: docs('install/'), label: 'Install guide' },
                },
                {
                    label: 'STIG-style controls',
                    detail: 'The ENS platform baseline: a notice-and-consent banner, idle, administrator and absolute session timeouts and a sessions-per-user limit, security headers and CSRF protection, client-certificate revocation checking and allowed issuers, and the Helm chart&rsquo;s non-root, read-only containers.',
                    docs: { href: docs('fips-and-stig/'), label: 'FIPS 140-3 and DISA STIG' },
                },
                {
                    label: 'FIPS 140-3',
                    detail: 'Runs on FIPS-mode RHEL or OpenShift hosts, taking its cryptography from Red Hat&rsquo;s OpenJDK, and the license check accepts a license&rsquo;s ECDSA P-256 co-signature where Ed25519 is unavailable. ENS supplies no validated cryptographic module and claims no validation; the application has not yet been run end to end in FIPS mode.',
                    docs: { href: docsUrl('fips-and-stig/'), label: 'FIPS position' },
                },
                {
                    label: 'Accessibility',
                    detail: 'Targets WCAG 2.1 AA (Section 508). Every build scans every page with axe-core and fails on a serious or critical violation. A self-audit and a draft VPAT are available on request; conformance is not yet claimed.',
                    docs: { href: docs('accessibility/'), label: 'Accessibility' },
                },
            ]}
        />
    </div>
</section>

<section class="section" aria-labelledby="scope-heading">
    <div class="wrap">
        <h2 id="scope-heading">What it does, and what it does not yet</h2>
        <p class="lede">
            For your shortlist: what is in the product today, what is there in part, and what it does
            not do yet. &ldquo;Not yet&rdquo; means not in the current release; ask us about the roadmap.
        </p>
        <CapabilityTable
            caption="CertAlert capabilities today"
            rows={[
                { label: 'Discovery from an LDAP directory', status: 'included', note: 'Paged sweeps and the changelog connector; one directory per installation.' },
                { label: 'Ownership and routing of alerts', status: 'included', note: 'Points of contact, contact addresses, projects and bulk assignment.' },
                { label: 'Revocation checking', status: 'included', note: 'CRL, and OCSP where no CRL exists, on a schedule and optionally at sign-in.' },
                { label: 'Single sign-on with roles from groups', status: 'included', note: 'OpenID Connect and SAML 2.0; administrators and auditors from provider groups.' },
                { label: 'REST API, tokens and OpenAPI', status: 'included', note: 'Scoped, expiring tokens; rate limits apply per replica.' },
                { label: 'Inventory search and export', status: 'included', note: 'CSV and Excel, saved views and scheduled e-mailed reports.' },
                { label: 'High availability, backup and recovery', status: 'included', note: 'Several replicas with the Helm chart; a database dump before every upgrade.' },
                { label: 'Metrics, logs and SIEM forwarding', status: 'included', note: 'Prometheus, JSON logs, Splunk HEC and syslog.' },
                { label: 'Alert channels', status: 'partial', note: 'E-mail, in-app, and JSON, Slack or Teams webhooks. No ticketing or paging connector; a webhook receiver bridges to those.' },
                { label: 'Crypto-agility reporting', status: 'partial', note: 'Filters by key algorithm, size and hash; no policy alerts and no cryptographic bill of materials.' },
                { label: 'Short-lived certificates', status: 'partial', note: 'Expiring-soon and critical thresholds (30 and 7 days by default) apply to every certificate alike; nothing yet distinguishes short-lived ones.' },
                { label: 'Proof for accreditation', status: 'partial', note: 'FIPS and STIG settings documented; no FIPS-mode test run yet, and the VPAT is a draft.' },
                { label: 'Network, CA and cloud discovery', status: 'not-yet', note: 'The directory is the only inventory source; a TLS probe checks one server on demand.' },
                { label: 'Renewal automation', status: 'not-yet', note: 'Monitoring only: no ACME, CA connectors or certificate installation.' },
            ]}
        />
    </div>
</section>

<section class="section" aria-labelledby="tech-heading">
    <div class="wrap">
        <h2 id="tech-heading">What you need to run it</h2>
        <div class="table-scroll">
            <table>
                <caption class="visually-hidden">CertAlert technical summary</caption>
                <thead>
                <tr>
                    <th scope="col">Component</th>
                    <th scope="col">Detail</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <th scope="row">Server</th>
                    <td>Spring Boot 4 on Java 21 with a Thymeleaf and Tabler web UI, shipped as a container on Red Hat UBI 9 that runs as non-root and under OpenShift&rsquo;s default policy</td>
                </tr>
                <tr>
                    <th scope="row">Deployment</th>
                    <td>A release package for Docker or Podman Compose, or a Helm chart for Kubernetes and OpenShift; signed images with an SBOM</td>
                </tr>
                <tr>
                    <th scope="row">Directory</th>
                    <td>LDAP / LDAPS with a read-only service account; optionally a changelog (<span class="mono">cn=changelog</span>) for near-real-time updates</td>
                </tr>
                <tr>
                    <th scope="row">Database</th>
                    <td>PostgreSQL, with the schema managed by Flyway migrations at startup</td>
                </tr>
                <tr>
                    <th scope="row">Authentication</th>
                    <td>X.509 client certificates already published in the directory (CAC or PIV), directory username and password, or single sign-on by OpenID Connect or SAML 2.0; reader, auditor and administrator roles</td>
                </tr>
                <tr>
                    <th scope="row">Email</th>
                    <td>An SMTP relay for the daily expiry round-up</td>
                </tr>
                <tr>
                    <th scope="row">Scale</th>
                    <td>Designed for directories of 100,000+ entries: paged reads, batched writes and memory use that stays flat as the directory grows</td>
                </tr>
                <tr>
                    <th scope="row">Configuration</th>
                    <td>Environment variables or external config; liveness and readiness probes and Prometheus metrics on a management port</td>
                </tr>
                </tbody>
            </table>
        </div>

        <div class="callout">
            <p>
                Want to see CertAlert against your directory?
                <a href="/contact.html?product=certalert">Get in touch</a> or email
                <a href="mailto:info@ens-solutions.com">info@ens-solutions.com</a>.
            </p>
        </div>
    </div>
</section>

<ProductPricing product="certalert">
    <div class="callout callout--value">
        <p>
            <strong>Priced against the outage it prevents.</strong> One certificate nobody renewed can take a
            mission system offline for a day. Enterprise certificate-management platforms commonly run
            {formatUSD(enterpriseCertificatePlatformRange.low)}&ndash;{formatUSD(enterpriseCertificatePlatformRange.high)}+
            a year; CertAlert covers the directory-published certificates of an on-premises shop at a fraction of that.
        </p>
    </div>
</ProductPricing>
</ProductLayout>
