---
import CapabilityTable from '../../components/CapabilityTable.astro';
import FactTable from '../../components/FactTable.astro';
import ProductPricing from '../../components/ProductPricing.astro';
import SavingsCalculator from '../../components/SavingsCalculator.astro';
import { docsUrl } from '../../data/site';
import ProductLayout from '../../layouts/ProductLayout.astro';

const docs = (page: string) => docsUrl(`rsa-operations-portal/${page}`);
---
<ProductLayout
    product="mfa-portal"
    description="RSA Operations Portal runs the day-to-day of an RSA SecurID program on top of RSA Authentication Manager: token assignment and self-service PIN resets, a Trusted Agent directory with appointments, multi-site token shipments, and verified, dual-controlled help-desk requests. Single sign-on for operators, a REST API and signed webhooks, a hash-chained audit trail; Compose package or Helm chart. Available now from ENS Solutions."
    headline="Run your SecurID program from one portal."
    sections={[
        { id: 'capabilities-heading', label: 'Features' },
        { id: 'screens-heading', label: 'Screens' },
        { id: 'fit-heading', label: 'How it fits' },
        { id: 'platform-heading', label: 'Security and integrations' },
        { id: 'scope-heading', label: 'Today and not yet' },
        { id: 'pricing-heading', label: 'Pricing' },
        { id: 'why-heading', label: 'Why it helps' },
    ]}
    tour={{ id: 'screens-heading', label: 'See the screens' }}
>
    <p class="lede" slot="lede">
        RSA Operations Portal sits in front of RSA Authentication Manager and handles the work
        around the tokens: users activate their token and reset their own PIN, Trusted Agents
        assign tokens and book appointments, the help desk handles lost tokens and lockouts, and
        the program office ships tokens to every site &mdash; all without handing out access to
        the Authentication Manager console.
    </p>
    <figure slot="aside" class="shot">
        <a href="/assets/img/screens/rsa-portal-user-details.jpg" class="shot-link" target="_blank" rel="noopener">
            <picture>
                <source media="(max-width: 640px)" srcset="/assets/img/screens/rsa-portal-user-details-mobile.jpg" width="720" height="814">
                <img src="/assets/img/screens/rsa-portal-user-details.jpg" width="1440" height="900" decoding="async"
                     alt="RSA Operations Portal user details page, showing a user's account, their assigned SecurID token with Reset Pin, Mark Lost and Generate Emergency Token Code buttons, and their enrollment history.">
            </picture>
            <span class="visually-hidden"> (opens full size in a new tab)</span>
        </a>
        <figcaption>Help desk view of a user: account status, token, and one-click PIN reset, lost-token and emergency-code actions.</figcaption>
    </figure>

<section class="section" aria-labelledby="capabilities-heading">
    <div class="wrap">
        <h2 id="capabilities-heading">What it does</h2>
        <div class="card-grid card-grid--pairs">
            <article class="card">
                <p class="card-kicker">Token holders</p>
                <h3>Self-service activation and PIN resets</h3>
                <p>
                    Users activate a newly assigned token, set their PIN and test their token from the
                    portal. A forgotten PIN can be reset with the user&rsquo;s PKI certificate, their
                    Windows password, or an emailed reset link &mdash; no help desk ticket required.
                </p>
            </article>
            <article class="card">
                <p class="card-kicker">Trusted Agents</p>
                <h3>A directory people can actually use</h3>
                <p>
                    Users find the Trusted Agent for their site and book a new-token, replacement or
                    return appointment. Agents assign tokens by serial number, confirm appointments, and
                    get a weekly digest of who is coming in.
                </p>
            </article>
            <article class="card">
                <p class="card-kicker">Help desk</p>
                <h3>Lost tokens, lockouts and emergency access</h3>
                <p>
                    Look up any user to reset a PIN, mark a token lost, unlock an account, issue a
                    one-day emergency tokencode, or deprovision a token back into the assignable pool.
                    Each privileged change is a help-desk request: a ticket, a verified user, a second
                    operator for privileged accounts, a notice to the user, and a record of it all.
                </p>
            </article>
            <article class="card">
                <p class="card-kicker">Program office</p>
                <h3>Token shipments to every site</h3>
                <p>
                    Sites request tokens, the program office ships a serial range, and the receiving
                    Trusted Agent confirms delivery. Every shipment is tracked from request to receipt,
                    with a printable packing sheet.
                </p>
            </article>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="screens-heading">
    <div class="wrap">
        <h2 id="screens-heading">A look inside</h2>
        <p class="lede">Screenshots of RSA Operations Portal with sample people, sites and tokens. Select one to see it full size.</p>
        <div class="shot-grid">
            <figure class="shot">
                <a href="/assets/img/screens/rsa-portal-trusted-agents.jpg" class="shot-link" target="_blank" rel="noopener">
                    <picture>
                        <source media="(max-width: 640px)" srcset="/assets/img/screens/rsa-portal-trusted-agents-mobile.jpg" width="640" height="728">
                        <img src="/assets/img/screens/rsa-portal-trusted-agents.jpg" width="1440" height="900" loading="lazy" decoding="async"
                             alt="Trusted Agent Directory: a searchable table of Trusted Agents with their site, city, state and country, and Details and Schedule Appointment buttons on each row.">
                    </picture>
                    <span class="visually-hidden"> (opens full size in a new tab)</span>
                </a>
                <figcaption><strong>Trusted Agent Directory.</strong> Searchable by name, site or location, with appointment booking on every row.</figcaption>
            </figure>
            <figure class="shot">
                <a href="/assets/img/screens/rsa-portal-shipments.jpg" class="shot-link" target="_blank" rel="noopener">
                    <picture>
                        <source media="(max-width: 640px)" srcset="/assets/img/screens/rsa-portal-shipments-mobile.jpg" width="700" height="648">
                        <img src="/assets/img/screens/rsa-portal-shipments.jpg" width="1440" height="900" loading="lazy" decoding="async"
                             alt="Shipments list: token shipments to several sites with the number of tokens requested, a status of New, Being Worked, Shipped or Received, and submitted, sent and received dates.">
                    </picture>
                    <span class="visually-hidden"> (opens full size in a new tab)</span>
                </a>
                <figcaption><strong>Shipments.</strong> Every token shipment from request to receipt, across all of your sites.</figcaption>
            </figure>
            <figure class="shot">
                <a href="/assets/img/screens/rsa-portal-ta-report.jpg" class="shot-link" target="_blank" rel="noopener">
                    <picture>
                        <source media="(max-width: 640px)" srcset="/assets/img/screens/rsa-portal-ta-report-mobile.jpg" width="700" height="462">
                        <img src="/assets/img/screens/rsa-portal-ta-report.jpg" width="1440" height="900" loading="lazy" decoding="async"
                             alt="Trusted Agent Report: the number of tokens a Trusted Agent has issued and an activity log of token assignments, emergency codes, shipments received and deprovisioned tokens.">
                    </picture>
                    <span class="visually-hidden"> (opens full size in a new tab)</span>
                </a>
                <figcaption><strong>Trusted Agent Report.</strong> Tokens issued and a full activity log for each agent, with the same report per site.</figcaption>
            </figure>
            <figure class="shot">
                <a href="/assets/img/screens/rsa-portal-home.jpg" class="shot-link" target="_blank" rel="noopener">
                    <picture>
                        <source media="(max-width: 640px)" srcset="/assets/img/screens/rsa-portal-home-mobile.jpg" width="700" height="499">
                        <img src="/assets/img/screens/rsa-portal-home.jpg" width="1440" height="900" loading="lazy" decoding="async"
                             alt="Portal home page: a welcome banner, a system notification announcing new tokens at two sites, and the role-based navigation menu for Trusted Agent, token management and program office tasks.">
                    </picture>
                    <span class="visually-hidden"> (opens full size in a new tab)</span>
                </a>
                <figcaption><strong>Home.</strong> Announcements and getting-started guidance for every user, and menus that show each person only the tasks for their role.</figcaption>
            </figure>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="fit-heading">
    <div class="wrap">
        <h2 id="fit-heading">How it fits</h2>
        <ol class="flow-steps">
            <li>
                <strong>RSA Authentication Manager stays in charge.</strong> Tokens, PINs and
                authentication policy remain in the Authentication Manager deployment you already run.
                The portal works through Authentication Manager&rsquo;s own administration API, using a
                service account scoped to one security domain.
            </li>
            <li>
                <strong>Roles come from Authentication Manager, or your identity provider.</strong>
                Trusted Agent, help desk and program office access map to administrative roles you
                already assign in Authentication Manager, or to groups in your identity provider.
                Everyone signs in with their user ID and SecurID passcode; operators can start with
                single sign-on by OpenID Connect or SAML&nbsp;2.0 and then enter their passcode.
            </li>
            <li>
                <strong>The routine follow-up runs itself.</strong> Scheduled jobs warn users before
                their token expires, remind them to set a PIN, send appointment reminders, keep the
                Trusted Agent list in step with Authentication Manager, and alert the program office
                when someone keeps losing tokens.
            </li>
            <li>
                <strong>Deploys on your own servers.</strong> The portal, its Authentication Manager
                connector and a MySQL database run as containers under Docker or Podman Compose, with
                install, upgrade, backup and restore scripts included, or from a Helm chart on
                Kubernetes or OpenShift. The connector is the only component that reaches Authentication
                Manager, over mutual TLS. Logos, banners and wording can be changed to match your program.
            </li>
        </ol>
    </div>
</section>

<section class="section" aria-labelledby="platform-heading">
    <div class="wrap">
        <h2 id="platform-heading">Security and integrations</h2>
        <p class="lede">
            What a security reviewer or an integrator will ask about, in one place. Each row links the
            documentation page that describes it in full.
        </p>
        <FactTable
            caption="RSA Operations Portal security and integration summary"
            rows={[
                {
                    label: 'Sign-in',
                    detail: 'Everyone signs in with their Authentication Manager user ID and SecurID passcode. Operators can start with single sign-on by OpenID Connect or SAML&nbsp;2.0 and then enter their passcode, with the identity provider&rsquo;s groups deciding their Portal roles; roles can also map to Authentication Manager&rsquo;s administrative roles.',
                    docs: { href: docs('single-sign-on/'), label: 'Single sign-on' },
                },
                {
                    label: 'Help-desk requests',
                    detail: 'Marking a token lost, resetting a PIN, deprovisioning, issuing an emergency access code and clearing a cached Windows password each open a request: a ticket, a verified user (certificate, Windows password and serial, or an e-mailed code), a second operator&rsquo;s approval for privileged users, and a notice to the user.',
                    docs: { href: docs('help-desk/'), label: 'Help-desk requests' },
                },
                {
                    label: 'Abuse controls',
                    detail: 'The steps anyone can reach without signing in are rate-limited per client address and per user ID, back off after repeated failures and give one answer whatever the cause; the Portal&rsquo;s limits sit on top of Authentication Manager&rsquo;s lockout policy.',
                    docs: { href: docs('security/'), label: 'Security' },
                },
                {
                    label: 'The Authentication Manager hop',
                    detail: 'Only the Connector talks to Authentication Manager, over HTTPS protected by a shared secret and mutual TLS (on in new installations). It checks AM&rsquo;s certificate and host name, reads AM&rsquo;s replies through a deserialization filter, and runs each operator&rsquo;s changes in that operator&rsquo;s own AM session, with least-privilege AM roles documented.',
                    docs: { href: docs('rsa-integration/'), label: 'RSA AM integration' },
                },
                {
                    label: 'Public API',
                    detail: 'A versioned REST API at <span class="mono">/api/v1</span> with an OpenAPI document, for ITSM and identity-governance tools: scoped tokens with a service identity and an expiry read users and tokens, and changes open help-desk requests rather than bypassing them.',
                    docs: { href: docs('api-reference/'), label: 'API reference' },
                },
                {
                    label: 'Webhooks',
                    detail: 'HMAC-signed webhooks for help-desk, token and account events, with a guard against requests to internal addresses.',
                    docs: { href: docs('webhooks/'), label: 'Webhooks' },
                },
                {
                    label: 'Reports and exports',
                    detail: 'Trusted Agent and site reports with each agent&rsquo;s activity, and the audit log exported as CSV or NDJSON.',
                    docs: { href: docs('admin-guide/'), label: 'Admin guide' },
                },
                {
                    label: 'High availability',
                    detail: 'Several Portal replicas with the Helm chart, with sessions, job locks and the license state in MySQL. The Connector runs as one replica by design, and emergency access codes need session affinity to the Portal replica that made them.',
                    docs: { href: docs('availability-and-sizing/'), label: 'Sizing, availability and recovery' },
                },
                {
                    label: 'Audit trail',
                    detail: 'Every sign-in, refusal, help-desk step and Authentication Manager change in the hash-chained <span class="mono">ens-audit/1</span> trail. A change attempt is recorded before every AM change, and refused if it cannot be. Searchable and verifiable in the app, exported as CSV or NDJSON, forwarded to Splunk HEC or syslog, or pulled by your SIEM through an API token.',
                    docs: { href: docsUrl('audit-logging/'), label: 'Audit logging' },
                },
                {
                    label: 'Observability',
                    detail: 'Prometheus metrics and health probes on a separate management port; a request id on every log line, returned in the response and recorded in the audit trail, so the three can be matched; and optional JSON logs in Elastic Common Schema.',
                    docs: { href: docs('operator-guide/'), label: 'Operator guide' },
                },
                {
                    label: 'Deployment',
                    detail: 'A release package that runs the Portal, the Connector and MySQL 8.4 as three containers under Docker or Podman Compose (podman-compose 1.0.6 or newer), with install, upgrade, backup and restore scripts, or a Helm chart for Kubernetes and OpenShift that uses your MySQL server. Images are built on Red Hat UBI&nbsp;9; both are signed with cosign by digest, with an SPDX SBOM in the download and attested on the images, and the CI vulnerability scan&rsquo;s accepted risks are listed with a review date.',
                    docs: { href: docs('install/'), label: 'Install guide' },
                },
                {
                    label: 'STIG-style controls',
                    detail: 'The ENS platform baseline: a notice-and-consent banner shown before any page or self-service step, idle, administrator and absolute session timeouts and a sessions-per-user limit, security headers and CSRF protection, and the Helm chart&rsquo;s non-root, read-only containers.',
                    docs: { href: docs('fips-and-stig/'), label: 'FIPS 140-3 and DISA STIG' },
                },
                {
                    label: 'FIPS 140-3',
                    detail: 'Runs on FIPS-mode RHEL or OpenShift hosts, taking its cryptography from Red Hat&rsquo;s OpenJDK, and the license check accepts a license&rsquo;s ECDSA P-256 co-signature where Ed25519 is unavailable. ENS supplies no validated cryptographic module and claims no validation; the Authentication Manager SDK&rsquo;s cryptography is RSA&rsquo;s to state, and the Portal has not yet been run end to end in FIPS mode.',
                    docs: { href: docsUrl('fips-and-stig/'), label: 'FIPS position' },
                },
                {
                    label: 'Accessibility',
                    detail: 'Checked against WCAG 2.0, 2.1 and 2.2 A and AA on every build: axe-core runs through a real browser against the main pages, signed in and anonymously, and fails on a serious or critical violation. A self-assessment and a draft VPAT are available on request; conformance is not yet claimed, and the interface is English only.',
                    docs: { href: docs('accessibility/'), label: 'Accessibility' },
                },
            ]}
        />
    </div>
</section>

<section class="section" aria-labelledby="scope-heading">
    <div class="wrap">
        <h2 id="scope-heading">What it does, and what it does not yet</h2>
        <p class="lede">
            For your shortlist: what is in the product today, what is there in part, and what it does
            not do yet. &ldquo;Not yet&rdquo; means not in the current release; ask us about the roadmap.
        </p>
        <CapabilityTable
            caption="RSA Operations Portal capabilities today"
            rows={[
                { label: 'Self-service token activation and PIN set', status: 'included', note: 'Test the token, set the PIN, done; no help-desk ticket.' },
                { label: 'PIN reset with identity proofing', status: 'included', note: 'A certificate, the Windows password and token serial, or an e-mailed link.' },
                { label: 'Hardware token inventory and shipments', status: 'included', note: 'Sites, serial ranges, states and packing sheets; no carrier tracking.' },
                { label: 'Help-desk verification, dual control and user notice', status: 'included', note: 'Every privileged change is a verified, recorded request.' },
                { label: 'Single sign-on for operators', status: 'included', note: 'OpenID Connect and SAML 2.0, followed by the SecurID passcode.' },
                { label: 'Operations API and webhooks', status: 'included', note: 'Scoped tokens, an OpenAPI document and signed events; no ready-made ITSM app.' },
                { label: 'Audit, logs and metrics', status: 'included', note: 'Hash-chained trail to Splunk, syslog or a pull API; Prometheus; JSON logs.' },
                { label: 'Lost and stolen tokens', status: 'partial', note: 'Reported through the help desk, with a notice to the user; no self-report.' },
                { label: 'Expiry and replacement', status: 'partial', note: 'Reminders before a token expires and a replacement appointment; no campaign view.' },
                { label: 'Reports and exports', status: 'partial', note: 'Agent and site reports and an audit export; no scheduled reports.' },
                { label: 'High availability', status: 'partial', note: 'Several Portal replicas; the Connector runs as one by design.' },
                { label: 'Proof for accreditation', status: 'partial', note: 'FIPS and STIG settings documented; no FIPS-mode test run yet, and the VPAT is a draft.' },
                { label: 'Software token provisioning', status: 'not-yet', note: 'Hardware tokens only; no CT-KIP or QR enrollment.' },
                { label: 'Self-service emergency access', status: 'not-yet', note: 'Emergency access codes are issued by the help desk.' },
                { label: 'Languages other than English', status: 'not-yet', note: 'One English interface; wording and branding are configurable.' },
            ]}
        />
    </div>
</section>

<ProductPricing product="mfa-portal">
    <SavingsCalculator />
</ProductPricing>

<section class="section" aria-labelledby="why-heading">
    <div class="wrap">
        <h2 id="why-heading">Why it helps</h2>
        <div class="feature-grid">
            <div class="feature">
                <h3>Fewer PIN tickets</h3>
                <p>
                    Users reset their own PINs with credentials they already have, which leaves the help
                    desk free for the problems that need a person.
                </p>
            </div>
            <div class="feature">
                <h3>Tokens you can account for</h3>
                <p>
                    Every assignment, shipment, lost token and emergency code is logged, so you can see
                    where each token went and who handled it.
                </p>
            </div>
            <div class="feature">
                <h3>Less time in the console</h3>
                <p>
                    Trusted Agents and help desk staff get a focused tool for their daily tasks instead of
                    broad access to Authentication Manager.
                </p>
            </div>
        </div>

        <div class="callout">
            <p>
                <strong>RSA Operations Portal is available now.</strong> If you run RSA SecurID with
                Authentication Manager and want to see it with your own workflows,
                <a href="/contact.html?product=mfa-portal">get in touch</a> to arrange a demo, or follow
                us on <a href="https://www.linkedin.com/company/ens-solutions-llc/">LinkedIn</a>.
            </p>
            <p class="small muted">
                RSA and SecurID are trademarks of RSA Security LLC. RSA Operations Portal is a product of
                ENS Solutions, LLC and is not affiliated with or endorsed by RSA Security.
            </p>
        </div>
    </div>
</section>
</ProductLayout>
