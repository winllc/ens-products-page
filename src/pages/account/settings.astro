---
export const prerender = false;

import AccountLayout from '../../layouts/AccountLayout.astro';
import { AccountError, changePassword, updateProfile } from '../../server/accounts';
import { form, requireAccount, withNotice } from '../../server/http';
import { PASSWORD_MIN } from '../../server/secrets';

const signedIn = requireAccount(Astro);
if (signedIn instanceof Response) return signedIn;
let account = signedIn;

let error: string | null = null;
if (Astro.request.method === 'POST') {
    const get = await form(Astro);
    try {
        if (get('action') === 'profile') {
            account = updateProfile(account, { name: get('name'), organization: get('organization'), phone: get('phone') });
            return Astro.redirect(withNotice('/account/settings', 'profile-saved'), 303);
        }
        if (get('action') === 'password') {
            await changePassword(account, get('current'), get('password'), Astro.locals.sessionToken ?? '');
            return Astro.redirect(withNotice('/account/settings', 'password-changed'), 303);
        }
    } catch (err) {
        if (!(err instanceof AccountError)) throw err;
        error = err.message;
    }
}
---
<AccountLayout title="Settings" section="settings" error={error}>
    <div class="split">
        <form method="post" class="panel">
            <h2>Your details</h2>
            <p class="muted small">
                Your name and organization go on licenses issued from now on. Existing license files keep the
                details they were issued with. To change your email address, <a href="/contact.html">contact us</a>.
            </p>
            <input type="hidden" name="action" value="profile">
            <div class="field">
                <label for="email">Email</label>
                <input id="email" value={account.email} disabled>
            </div>
            <div class="field">
                <label for="name">Name</label>
                <input id="name" name="name" autocomplete="name" required maxlength="120" value={account.name}>
            </div>
            <div class="field">
                <label for="organization">Organization</label>
                <input id="organization" name="organization" autocomplete="organization" maxlength="160" value={account.organization}>
            </div>
            <div class="field">
                <label for="phone">Phone</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" value={account.phone}>
            </div>
            <button class="btn btn--primary" type="submit">Save details</button>
        </form>

        <form method="post" class="panel">
            <h2>Password</h2>
            <p class="muted small">Changing it signs you out everywhere else.</p>
            <input type="hidden" name="action" value="password">
            <input type="hidden" name="username" autocomplete="username" value={account.email}>
            <div class="field">
                <label for="current">Current password</label>
                <input id="current" name="current" type="password" autocomplete="current-password" required>
            </div>
            <div class="field">
                <label for="password">New password</label>
                <input id="password" name="password" type="password" autocomplete="new-password" required minlength={PASSWORD_MIN} maxlength="256">
            </div>
            <button class="btn btn--primary" type="submit">Change password</button>
        </form>
    </div>
</AccountLayout>
