---
import type { AuditEntry } from '../../server/audit';

interface Props {
    entries: AuditEntry[];
    showActor?: boolean;
}

const { entries, showActor = true } = Astro.props;
const when = (iso: string) => iso.replace('T', ' ').slice(0, 16) + ' UTC';
---
<ol class="audit-list">
    {entries.map((e) => (
        <li>
            <time datetime={e.at}>{when(e.at)}</time>
            <span>
                <strong>{e.label}</strong>
                {e.detail && <> &middot; {e.detail}</>}
                {e.license_id && <> &middot; <span class="mono small">{e.license_id}</span></>}
                {showActor && e.actor_email && <span class="muted"> by {e.actor_email}</span>}
            </span>
        </li>
    ))}
</ol>
