---
/*
 * Shell for the licensing pages: the site layout, a heading, the account
 * navigation when someone is signed in, and the notice carried across the
 * last redirect.
 */
import { isAdmin } from '../server/accounts';
import { noticeFrom } from '../server/http';
import BaseLayout from './BaseLayout.astro';

interface Props {
    title: string;
    heading?: string;
    eyebrow?: string;
    section?: 'licenses' | 'downloads' | 'settings' | 'check' | 'admin' | 'admin-accounts' | 'admin-licenses' | 'admin-leads' | 'admin-audit';
    /** Narrow single-column layout, for sign-in and sign-up forms. */
    narrow?: boolean;
    error?: string | null;
}

const { title, heading = title, eyebrow = 'Licensing', section, narrow = false, error = null } = Astro.props;
const account = Astro.locals.account;
const notice = noticeFrom(Astro.url);
const admin = isAdmin(account);
const inAdmin = section?.startsWith('admin');
---
<BaseLayout title={title}>
    <section class="hero hero--compact">
        <div class:list={['wrap', { 'wrap--narrow': narrow }]}>
            <p class="eyebrow">{eyebrow}</p>
            <h1>{heading}</h1>
            <slot name="lede" />
            {account && (
                <nav class="account-nav" aria-label="Account">
                    {inAdmin ? (
                        <>
                            <a href="/admin" aria-current={section === 'admin' ? 'page' : undefined}>Overview</a>
                            <a href="/admin/licenses" aria-current={section === 'admin-licenses' ? 'page' : undefined}>Licenses</a>
                            <a href="/admin/accounts" aria-current={section === 'admin-accounts' ? 'page' : undefined}>Accounts</a>
                            <a href="/admin/leads" aria-current={section === 'admin-leads' ? 'page' : undefined}>Leads</a>
                            <a href="/admin/audit" aria-current={section === 'admin-audit' ? 'page' : undefined}>Audit log</a>
                            <a href="/account">My account</a>
                        </>
                    ) : (
                        <>
                            <a href="/account" aria-current={section === 'licenses' ? 'page' : undefined}>Licenses</a>
                            <a href="/account/downloads" aria-current={section === 'downloads' ? 'page' : undefined}>Downloads</a>
                            <a href="/account/check" aria-current={section === 'check' ? 'page' : undefined}>Check a file</a>
                            <a href="/account/settings" aria-current={section === 'settings' ? 'page' : undefined}>Settings</a>
                            {admin && <a href="/admin">Administration</a>}
                        </>
                    )}
                    <form method="post" action="/account/logout" class="account-nav-signout">
                        <span class="muted small">{account.email}</span>
                        <button class="link-button" type="submit">Sign out</button>
                    </form>
                </nav>
            )}
        </div>
    </section>
    <section class="section section--tight">
        <div class:list={['wrap', { 'wrap--narrow': narrow }]}>
            {notice && <p class="notice" role="status">{notice}</p>}
            {error && <p class="notice notice--error" role="alert">{error}</p>}
            <slot />
        </div>
    </section>
</BaseLayout>
