---
/*
 * The page shell every page shares: head, header, footer. Before the move to
 * Astro these were copied into each page by hand; now a nav change is one edit
 * in SiteHeader.astro.
 *
 * The head carries what search engines and link previews read: a canonical
 * URL, Open Graph and Twitter card tags built from the page's title and
 * description, and the company logo as the preview image. A page adds its own
 * structured data (JSON-LD) through the "head" slot; src/lib/structured-data.ts
 * builds it from the site's data files.
 */
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/site.css';

interface Props {
    /** Page name. " — ENS Solutions, LLC" is appended. */
    title: string;
    description?: string;
    /**
     * Keep the page out of search results. The licensing pages set it; they
     * are behind a sign-in anyway, and robots.txt keeps crawlers out of them.
     */
    noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = `${title} — ENS Solutions, LLC`;

// The canonical address of this page. Astro reports /products/certalert for
// the prerendered /products/certalert.html, and /index.html for the homepage
// (build.format 'file'), so the extension is put back and the homepage is
// "/"; the licensing pages, rendered on demand, are served at their own
// paths. The site's address comes from astro.config.mjs.
const site = Astro.site ?? new URL('https://products.ens-solutions.com');
const path = Astro.url.pathname.replace(/\/+$/, '').replace(/\/index(\.html)?$/, '') || '/';
const canonicalPath = Astro.isPrerendered && path !== '/' && !path.endsWith('.html') ? `${path}.html` : path;
const canonical = new URL(canonicalPath, site).href;
// Written as an absolute URL, which link previews need. The render script
// versions only quoted root-relative references, so this one stays stable.
const ogImage = new URL('/assets/img/brand/ens-solutions-logo.jpg', site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description}>}
    {noindex && <meta name="robots" content="noindex, nofollow">}
    <link rel="canonical" href={canonical}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="ENS Solutions, LLC">
    <meta property="og:title" content={fullTitle}>
    {description && <meta property="og:description" content={description}>}
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="548">
    <meta property="og:image:height" content="100">
    <meta property="og:image:alt" content="ENS Solutions, LLC">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content={fullTitle}>
    {description && <meta name="twitter:description" content={description}>}
    <meta name="twitter:image" content={ogImage}>
    <link rel="icon" href="/assets/img/brand/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/assets/img/brand/icon-192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/assets/img/brand/apple-touch-icon.png">
    <meta name="theme-color" content="#1d5a72">
    <slot name="head" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<SiteHeader />

<main id="main">
<slot />
</main>

<SiteFooter />
</body>
</html>
