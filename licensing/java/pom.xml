<?xml version="1.0" encoding="UTF-8"?>
<!--
  ENS license verifier: checks ENS Solutions license files inside the
  applications (CertAlert, RSA Operations Portal, ReadyRoom, Directory
  Services Portal). Plain Java 21 with no runtime dependencies, so it adds
  nothing to an application's dependency tree or its ATO package, and works
  with no network.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.enssolutions</groupId>
    <artifactId>ens-license</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>ENS license verifier</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Files signed by the site's TypeScript code; see src/lib/licensing/fixtures.test.ts -->
                        <ens.license.fixtures>${project.basedir}/../fixtures</ens.license.fixtures>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
