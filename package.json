{
  "name": "ens-products-page",
  "private": true,
  "type": "module",
  "description": "Product site for ENS Solutions, LLC",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "render": "SITE_TEMPLATE_DIR=dist SITE_OUTPUT_DIR=dist-rendered sh docker/docker-entrypoint.d/30-render-site.sh",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
