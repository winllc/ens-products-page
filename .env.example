# Copy to .env and fill in. Anything left empty renders as "coming soon"
# rather than as a dead link.
#
# These are read at container start, so a change takes effect on restart —
# no rebuild.

READYROOM_DEMO_URL=https://demo.example.com/readyroom
CERTALERT_DEMO_URL=
MFA_PORTAL_DEMO_URL=
DIRECTORY_PORTAL_DEMO_URL=

# ---- Licensing service ------------------------------------------------------
# The address customers reach the site at; links in emails start with it.
PUBLIC_URL=https://products.ens-solutions.com
# These accounts become administrators once they confirm their email.
ADMIN_EMAILS=
# Ed25519 private key from `npm run license -- keygen` (its one-line form). Keep it secret.
# Left empty, the service generates one in its data volume on first start.
LICENSE_SIGNING_KEY=
# Retired public keys still accepted when checking a file (base64, comma-separated).
LICENSE_TRUSTED_KEYS=
# Outgoing mail for confirmations and resets, e.g. smtps://user:pass@mail.example.com:465.
# Empty: emails are written to the licensing service's log instead.
SMTP_URL=
MAIL_FROM=ENS Solutions <licensing@ens-solutions.com>
