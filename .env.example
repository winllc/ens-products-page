# Copy to .env and fill in. Anything left empty renders as "coming soon"
# rather than as a dead link.
#
# These are read at container start, so a change takes effect on restart —
# no rebuild.

READYROOM_DEMO_URL=https://demo.example.com/readyroom
CERTALERT_DEMO_URL=
MFA_PORTAL_DEMO_URL=
DIRECTORY_PORTAL_DEMO_URL=

# Where the Docs links go. Empty for the published documentation site
# (https://winllc.github.io/ens-apps-documentation); set it to a mirror's URL on
# a network that cannot reach that.
DOCS_URL=

# ---- Licensing service ------------------------------------------------------
# The address customers reach the site at; links in emails start with it.
PUBLIC_URL=https://products.ens-solutions.com
# These accounts become administrators once they confirm their email.
ADMIN_EMAILS=
# Require customers to confirm their email before taking a license. true/false.
REQUIRE_EMAIL_VERIFICATION=true
# Ed25519 private key from `npm run license -- keygen` (its one-line form). Keep it secret.
# Left empty, the service generates one in its data volume on first start.
LICENSE_SIGNING_KEY=
# ECDSA P-256 private key from `npm run license -- keygen --alg p256` (its one-line
# form). Optional: set, licenses are also signed with it, for Java in FIPS mode.
LICENSE_SIGNING_KEY_P256=
# Retired public keys still accepted when checking a file (base64, comma-separated).
LICENSE_TRUSTED_KEYS=
# Outgoing mail for confirmations and resets, e.g. smtps://user:pass@mail.example.com:465.
# Empty: emails are written to the licensing service's log instead.
SMTP_URL=
MAIL_FROM=ENS Solutions <licensing@ens-solutions.com>

# ---- Audit logging ------------------------------------------------------------
# Every sign-in, change, download and denial is recorded in the database and
# shown at /admin/audit. These copy the trail elsewhere (README, "Audit logging").
#
# One raw JSON line per event on stdout (for Docker logging drivers). true/false.
ENS_AUDIT_STDOUT=true
# Also append the lines to a file, rotated daily or at 100 MB, e.g.
# /var/log/ens/licensing-portal/audit.jsonl (the ens-audit volume). Empty: off.
ENS_AUDIT_FILE=
# Rotated files to keep.
ENS_AUDIT_FILE_KEEP=30
# Splunk HTTP Event Collector, e.g. https://splunk.example.com:8088. Empty: off.
ENS_AUDIT_SPLUNK_URL=
# The HEC token (a secret), or a file holding it.
ENS_AUDIT_SPLUNK_TOKEN=
ENS_AUDIT_SPLUNK_TOKEN_FILE=
# Optional index; the sourcetype defaults to ens:audit.
ENS_AUDIT_SPLUNK_INDEX=
ENS_AUDIT_SPLUNK_SOURCETYPE=ens:audit
# true skips verifying the HEC certificate. Test setups only; trust a private CA
# with NODE_EXTRA_CA_CERTS instead.
ENS_AUDIT_SPLUNK_INSECURE=false
# Syslog receiver (RFC 5424). Empty: off.
ENS_AUDIT_SYSLOG_HOST=
# Default 514 for udp and tcp, 6514 for tls.
ENS_AUDIT_SYSLOG_PORT=
# udp, tcp or tls.
ENS_AUDIT_SYSLOG_PROTOCOL=tcp
ENS_AUDIT_SYSLOG_FACILITY=local0
# Delete events older than this many days once every output has delivered them.
# 0 keeps them forever.
ENS_AUDIT_RETENTION_DAYS=0
